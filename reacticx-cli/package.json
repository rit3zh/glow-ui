{
  "name": "reacticx",
  "version": "0.2.0",
  "description": "React Native components, copied into your project",
  "homepage": "https://www.reacticx.com/",
  "type": "module",
  "bin": {
    "reacticx": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.mjs\"",
    "test": "node test/smoke.mjs",
    "test:verbose": "node test/smoke.mjs --verbose",
    "check": "bun run typecheck && bun run build && bun run test",
    "clean": "rm -rf dist",
    "link": "bun link",
    "unlink": "bun unlink",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "terser": "^5.46.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "ora": "^8.0.0",
    "prompts": "^2.4.2"
  },
  "keywords": [
    "react-native",
    "expo",
    "components",
    "ui",
    "cli",
    "registry",
    "reacticx"
  ],
  "license": "MIT"
}
