# Generated by cloudflare/codebase/build-types.ts
cloudflare/codebase/types-build/

# Cloudflare media — the buckets are the source of truth, not git.
#
# ~230 MB of recordings that change every time a component is re-recorded.
# Committing them meant every clone carried every version of every clip. The
# ledgers next to them ARE committed, and describe every object well enough to
# restore the folders byte for byte:
#
#   bun run cloud pull     get the media back on a fresh clone
#   bun run cloud          re-upload whatever has changed
cloudflare/landing-assets/
cloudflare/v2-preview/
cloudflare/v2-preview-webm/

# vendored reference projects
inspo/
website/inspo/

# wrangler local vars
.dev.vars
cloudflare/v2-mockups/
