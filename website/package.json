{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "changelog": "bun scripts/changelog/index.ts",
    "changelog:dry": "bun scripts/changelog/index.ts --dry",
    "components:scaffold": "bun scripts/components/scaffold.ts",
    "components:sync": "bun scripts/components/index.ts",
    "components:sync:dry": "bun scripts/components/index.ts --dry",
    "components:check": "bun scripts/components/index.ts --check",
    "components:prune": "bun scripts/components/index.ts --prune",
    "deploy": "rm -rf .next .open-next && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:fresh": "rm -rf .next .open-next && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
